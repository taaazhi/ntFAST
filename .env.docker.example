# ─────────────────────────────────────────────
# ntFAST — Docker environment
# Copy to .env.docker before `docker compose up`:
#     cp .env.docker.example .env.docker
# docker-compose.yml reads .env.docker for the backend and celery_worker
# services, so compose will not start until this file exists.
# ─────────────────────────────────────────────

# ── Database ────────────────────────────────
POSTGRES_DB=financial_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Application ─────────────────────────────
DEBUG=true

# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# With DEBUG=true a weak key is replaced by an ephemeral one at startup, which
# means every restart invalidates existing logins. Set a real key to avoid that;
# with DEBUG=false the app refuses to start without one.
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ── Email (optional) ────────────────────────
SMTP_SERVER=smtp.mail.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
USE_REAL_EMAIL=false

# ── AI integration (optional) ───────────────
# Ollama is NOT part of docker-compose.yml. Run it on the host
# (`ollama pull llama3.1`) and the containers reach it via host.docker.internal.
CLAUDE_API_KEY=
AI_PRIMARY_PROVIDER=claude
OLLAMA_HOST=http://host.docker.internal:11434
