# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/financial_analysis

# Security — ОБЯЗАТЕЛЬНО сгенерируйте уникальный ключ:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32

# Email Configuration (Mail.ru SMTP)
SMTP_SERVER=smtp.mail.ru
SMTP_PORT=587
SMTP_USERNAME=your_email@mail.ru
SMTP_PASSWORD=your_app_password
USE_REAL_EMAIL=false

# AI Configuration (optional)
CLAUDE_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Debug mode (set to false in production)
DEBUG=true

# ── Ограничение частоты обращений ────────────────────────────────────
#
# Доверять ли заголовкам X-Forwarded-For / X-Real-IP при определении адреса
# клиента. Оставьте false, если приложение принимает запросы напрямую:
# заголовок ставит сам клиент, и при доверии к нему защита от перебора
# паролей обходится подстановкой нового адреса в каждый запрос.
#
# ВАЖНО: одной этой настройки мало. uvicorn по умолчанию тоже доверяет
# X-Forwarded-For всем, кто пришёл с localhost, и подменяет адрес ещё до
# приложения. Без обратного прокси запускайте так:
#
#   FORWARDED_ALLOW_IPS="" uvicorn app.main:app --host 0.0.0.0 --port 8000
#
# За прокси — включите TRUST_PROXY_HEADERS=true, задайте FORWARDED_ALLOW_IPS
# адресом прокси и закройте прямой доступ к порту приложения.
TRUST_PROXY_HEADERS=false

# Где вести счётчики обращений. База в URL заменяется на отдельную (/1),
# чтобы счётчики не смешивались с очередью Celery. Пусто — считать в памяти
# процесса: тогда при нескольких воркерах предел выше заявленного.
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
